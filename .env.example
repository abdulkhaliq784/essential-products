# Copy this file to .env.local and fill in the values.
# NEVER put real keys in this file - it is uploaded to GitHub. Real values go in .env.local only.
# Only variables starting with NEXT_PUBLIC_ may reach the browser, so secrets must NEVER start with NEXT_PUBLIC_.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://vdledwdusjwnxscxesqg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Bypasses Row Level Security - keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
# Key ID: starts with rzp_test_ (test mode) or rzp_live_ (live mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Key Secret: shown once when you generate the key. It does NOT start with rzp_. Server only.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Any long random string you choose; must match the Secret entered in Razorpay -> Webhooks. Server only.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Site ---
# Local: http://localhost:3000   Production: https://essential-products.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
