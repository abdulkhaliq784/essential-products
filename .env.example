# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. Only variables starting with NEXT_PUBLIC_ are sent to the browser.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Bypasses Row Level Security - keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
# The Key ID is public; it is needed in the browser to open Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Server only.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Server only. The secret you type when creating the webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Site ---
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
